<?xml version="1.0"?>
<!--
  Unraid template for Transition Tracker.

  HOW TO USE:
  1. Replace YOUR_GITHUB_USERNAME below with your GitHub username (lowercase),
     so the Repository points at your published image, e.g.
     ghcr.io/bence/transition-tracker:latest
  2. In the Unraid web UI: Docker tab -> Add Container -> "Template" dropdown,
     or drop this file into /boot/config/plugins/dockerMan/templates-user/
     and it will appear in the template list.
  3. Fill in the DB_* fields (your external MariaDB), then Apply.

  The app creates the database and tables on first start; the DB user needs
  CREATE DATABASE permission (or pre-create the database and grant rights).
-->
<Container version="2">
  <Name>TransitionTracker</Name>
  <Repository>ghcr.io/YOUR_GITHUB_USERNAME/transition-tracker:latest</Repository>
  <Registry>https://ghcr.io/</Registry>
  <Network>bridge</Network>
  <MyIP/>
  <Shell>sh</Shell>
  <Privileged>false</Privileged>
  <Support/>
  <Project/>
  <Overview>Web-based project management tool for tracking recurring tasks across entities (racks, sites, countries, anything). Matrix RAG dashboard, configurable task template with deadlines derived from each entity's go-live date, inventory and notes per entity. Connects to an external MariaDB/MySQL server and creates its own database on first start.</Overview>
  <Category>Productivity: Tools: Network:Management</Category>
  <WebUI>http://[IP]:[PORT:8080]/</WebUI>
  <TemplateURL/>
  <Icon>https://raw.githubusercontent.com/YOUR_GITHUB_USERNAME/transition-tracker/main/frontend/public/favicon.svg</Icon>
  <ExtraParams/>
  <PostArgs/>
  <CPUset/>
  <DateInstalled/>
  <DonateText/>
  <DonateLink/>
  <Description>Transition Tracker — recurring-task tracking with a RAG matrix dashboard. Requires an external MariaDB/MySQL server; the app bootstraps its own database and schema.</Description>
  <Networking>
    <Mode>bridge</Mode>
    <Publish>
      <Port>
        <HostPort>8080</HostPort>
        <ContainerPort>8080</ContainerPort>
        <Protocol>tcp</Protocol>
      </Port>
    </Publish>
  </Networking>
  <Data/>
  <Environment>
    <Variable>
      <Value>3306</Value>
      <Name>DB_PORT</Name>
      <Mode/>
    </Variable>
  </Environment>
  <Config Name="WebUI Port" Target="8080" Default="8080" Mode="tcp" Description="Port the web interface is exposed on." Type="Port" Display="always" Required="true" Mask="false">8080</Config>
  <Config Name="DB_HOST" Target="DB_HOST" Default="" Mode="" Description="Hostname or IP of your external MariaDB/MySQL server." Type="Variable" Display="always" Required="true" Mask="false"></Config>
  <Config Name="DB_PORT" Target="DB_PORT" Default="3306" Mode="" Description="MariaDB/MySQL port." Type="Variable" Display="always" Required="true" Mask="false">3306</Config>
  <Config Name="DB_USER" Target="DB_USER" Default="" Mode="" Description="Database user. Needs CREATE DATABASE permission on first run." Type="Variable" Display="always" Required="true" Mask="false"></Config>
  <Config Name="DB_PASSWORD" Target="DB_PASSWORD" Default="" Mode="" Description="Database user password." Type="Variable" Display="always" Required="true" Mask="true"></Config>
  <Config Name="DB_NAME" Target="DB_NAME" Default="transition_tracker" Mode="" Description="Database name. Created automatically if it does not exist." Type="Variable" Display="always" Required="true" Mask="false">transition_tracker</Config>
</Container>
